% ================== PianoRollEditorTheme.oss ==================
% PianoRollEditor (src/test/PianoRollEditor.hpp) is a one-off tool, not part of Omnia, so its
% themeable properties live in their own file rather than inside DefaultTheme.oss - loaded
% additively (clearCurrentRules=false) on top of whatever base theme is already active.

(pianoRollEditor) {
	% ======= Base Widget properties =======
	borderColor = #2040BBFF
	borderWidth = 1
	showBorder = false
	focusBorderColor = #2FB000FF
	showFocusBorder = false
	focusBorderWidth = 1
	% ======================================

	selectionHighlightColor = #FFD700C0
	boxSelectColor = #4AA3FFA0
	scrollSpeedMultiplier = 1.0
	selectionBorderWidth = 3.0
	focusModeAlpha = 0.4

	% Per-slot highlight colors - slot 0 (the auto-backup slot) stays neutral gray since it's
	% not a deliberate "voice" the way 1-9 are. Falls back to these same values if omitted.
	slot0Color = #888888C0
	slot1Color = #E53935C0
	slot2Color = #1E88E5C0
	slot3Color = #43A047C0
	slot4Color = #FB8C00C0
	slot5Color = #8E24AAC0
	slot6Color = #00ACC1C0
	slot7Color = #D81B60C0
	slot8Color = #AFB42BC0
	slot9Color = #6D4C41C0
}

(@piano_roll_control_panel panel) {
	showBorder = false
	useBackgroundGradient = true
	backgroundGradient = gradientV(#111111FF - #222222FF)
}
% ================================================================
